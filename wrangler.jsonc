{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karaoke-backend-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "@aws-sdk/xml-builder": "@aws-sdk/xml-builder/dist-cjs/index.js",
  },
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "APP_ENV": "development",
    "FRONTEND_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000",
    "REGISTRATION_ENABLED": "false",
  },
  "ai": {
    "binding": "AI",
  },
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1101",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1102",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "env": {
    "preview": {
      "name": "karaoke-backend-preview",
      "vars": {
        "APP_ENV": "preview",
        "FRONTEND_ORIGINS": "https://configure-preview-frontend.invalid",
        "REGISTRATION_ENABLED": "false",
      },
      "ai": {
        "binding": "AI",
      },
      "ratelimits": [
        {
          "name": "API_LIMITER",
          "namespace_id": "1201",
          "simple": {
            "limit": 120,
            "period": 60,
          },
        },
        {
          "name": "AUTH_LIMITER",
          "namespace_id": "1202",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
      ],
    },
    "production": {
      "name": "karaoke-backend-production",
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "karaoke-media",
        },
      ],
      "vars": {
        "APP_ENV": "production",
        "FRONTEND_ORIGINS": "https://karaoke-backend-production.marclouiegi-olino.workers.dev,https://karaoke-frontend.marclouiegi-olino.workers.dev",
        "REGISTRATION_ENABLED": "false",
      },
      "ai": {
        "binding": "AI",
      },
      "ratelimits": [
        {
          "name": "API_LIMITER",
          "namespace_id": "1301",
          "simple": {
            "limit": 120,
            "period": 60,
          },
        },
        {
          "name": "AUTH_LIMITER",
          "namespace_id": "1302",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
      ],
      "triggers": {
        "crons": ["0 0 * * *"],
      },
    },
  },
}
